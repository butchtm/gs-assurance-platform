{
  "name": "assurance-front-end",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/open-sans": "^5.2.6",
    "@mui/icons-material": "^5.18.0",
    "@mui/lab": "^5.0.0-alpha.177",
    "@mui/material": "^5.18.0",
    "@mui/x-date-pickers": "^6.20.2",
    "@mui/x-tree-view": "^6.17.0",
    "@rjsf/core": "^5.24.13",
    "@rjsf/mui": "^5.24.13",
    "@rjsf/utils": "^5.24.13",
    "@rjsf/validator-ajv8": "^5.24.13",
    "axios": "^1.12.0",
    "better-npm-audit": "^3.11.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dayjs-business-days2": "^1.3.0",
    "express": "^5.1.0",
    "formik": "^2.4.6",
    "formik-mui": "^5.0.0-alpha.0",
    "husky": "^7.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "material-react-table": "^2.13.3",
    "mockdate": "^3.0.5",
    "npm-run-all": "^4.1.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-password-checklist": "^1.8.1",
    "react-qr-code": "^2.0.18",
    "react-quill-new": "^3.6.0",
    "react-router-dom": "^7.12.0",
    "react-toastify": "^9.1.3",
    "sass": "^1.90.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "yup": "^1.7.0"
  },
  "scripts": {
    "audit:better": "better-npm-audit audit",
    "start:react": "vite start",
    "start:express": "node src/express/server.js",
    "start": "vite",
    "build": "VITE_GIT_TAG=`git describe --tags` vite build && cp -r dist/ src/express/public/",
    "clean-public": "rm -rf src/express/public/*",
    "build-prod-local": "npm run clean-public && vite build && cp -r dist/* src/express/public/",
    "express-prod-local": "node src/express/server-prod-local.js",
    "start:prod-local": "npm-run-all --serial build-prod-local express-prod-local",
    "test": "jest --maxWorkers=50%",
    "test:ci": "npm run test -- --watchAll=false --ci --coverage --silent",
    "eject": "vite eject",
    "eslint": "npx eslint \"**/*.ts*\" --max-warnings=0",
    "eslint-fix": "npx eslint --fix \"**/*.ts*\"",
    "prettier": "npx prettier --check ./src",
    "prettier-fix": "npx prettier --write ./src",
    "lint": "npm run prettier && npm run eslint",
    "lint-fix": "npm run prettier-fix && npm run eslint-fix",
    "prepare": "husky install",
    "dev": "vite"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "execution-report.xml"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,scss}": "prettier --write",
    "*.js": "eslint --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/plugin-syntax-jsx": "^7.22.5",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.15.19",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-jest": "^29.6.1",
    "dotenv": "^16.3.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "http-proxy-middleware": "^3.0.5",
    "jest": "^30.0.5",
    "jest-fail-on-console": "^3.3.1",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^15.2.7",
    "lodash": "^4.17.23",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-plugin-sort-import-suggestions": "^1.0.4",
    "ts-unused-exports": "^10.1.0",
    "typescript": "^4.9.5",
    "vite": "^7.1.11",
    "vite-plugin-checker": "^0.12.0",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "overrides": {
    "on-headers": "^1.1.0",
    "js-yaml": "^4.1.1",
    "eslint": "^9.26.0"
  }
}
